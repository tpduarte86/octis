# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_WEB3FORMS_ACCESS_KEY: Free instant email delivery to contato@octis.com.br (250/mo free).
# Get a key in 10 seconds at https://web3forms.com/#start using contato@octis.com.br.
VITE_WEB3FORMS_ACCESS_KEY=""

# VITE_LEAD_WEBHOOK_URL: Optional HTTPS endpoint (Formspree https://formspree.io/f/...,
# Make, Zapier, n8n, or Google Apps Script) to receive simulator leads automatically.
VITE_LEAD_WEBHOOK_URL=""

# Cloudflare Pages Function (/api/simulator-lead) server-side env vars (set in Cloudflare Dashboard):
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Simulador Octis <contato@octis.com.br>"
# WEB3FORMS_ACCESS_KEY=""
# LEAD_WEBHOOK_URL=""
